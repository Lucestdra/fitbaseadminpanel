# Copy to .env.local for development.
#
# EXPO_PUBLIC_ is not a mistake: this value is compiled into the bundle and is readable by anyone
# who opens the app. That is fine — it is a URL, not a credential. Nothing secret belongs in an
# EXPO_PUBLIC_ variable, because there is no such thing as a secret in a client bundle.

# Where the API is.
#
# Empty in production, and that is the intended value there: the panel and the API are served from
# one origin behind Caddy (backend ADR-0019), which is what lets the refresh cookie work at all —
# a cross-origin cookie would need SameSite=None and would be sent to a third party on every
# request that touched it.
#
# In development the Expo web dev server is on 8081 and the API on 5000, so it has to be set. The
# API allows that origin only when running in Development; production registers no CORS policy.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
